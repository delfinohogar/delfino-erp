rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogueado() {
      return request.auth != null;
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function rol() {
      return perfil().rol;
    }

    function esAdministrador() {
      return estaLogueado() && rol() == 'administrador';
    }

    // Todo usuario logueado con perfil puede leer y escribir catálogo (productos, categorías, marcas, proveedores).
    // La escritura de campos sensibles (costos, overrides) queda para más adelante cuando haya permisos más finos por rol.
    function puedeEditarCatalogo() {
      return estaLogueado() && rol() in ['administrador', 'administrativo'];
    }

    // Todos los roles pueden vender (es el uso principal de un vendedor). Superset de puedeEditarCatalogo().
    function puedeVender() {
      return estaLogueado() && rol() in ['administrador', 'administrativo', 'vendedor'];
    }

    // Una venta descuenta stock de producto vía transacción — un vendedor necesita poder tocar ESE
    // campo puntual sin heredar permiso para editar costo/precio/etc. del catálogo.
    function soloActualizaStock() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockTotal', 'modificadoPor', 'modificadoEn']);
    }

    match /usuarios/{uid} {
      allow read: if estaLogueado();
      allow write: if esAdministrador();
      // Cada usuario puede guardar su propia personalización del Dashboard (qué tarjetas ve y en qué
      // orden) sin poder tocar su rol ni ningún otro campo del perfil.
      allow update: if estaLogueado() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dashboardCards']);
    }

    // Necesaria además de la regla anidada de más abajo: las collection group queries (ej. "Movimientos",
    // que junta el log de auditoría de todos los productos) solo se autorizan con una regla en la raíz
    // que use el wildcard recursivo {path=**} — la regla anidada dentro de /productos/{id} alcanza para
    // leer/escribir el historial de un producto puntual, pero no para la query agrupada.
    match /{path=**}/logAuditoria/{entryId} {
      allow read: if estaLogueado();
    }

    match /productos/{productoId} {
      allow read: if estaLogueado();
      allow create, update: if puedeEditarCatalogo() || (puedeVender() && soloActualizaStock());
      allow delete: if esAdministrador();

      match /historialCostos/{entryId} {
        allow read: if estaLogueado();
        allow create: if puedeEditarCatalogo();
        allow update, delete: if false; // historial inmutable
      }

      match /logAuditoria/{entryId} {
        allow read: if estaLogueado();
        allow create: if puedeVender(); // ventas y compras/ajustes de catálogo dejan entrada acá
        allow update, delete: if false; // log inmutable
      }

      match /stockPorDeposito/{depositoId} {
        allow read: if estaLogueado();
        allow write: if puedeEditarCatalogo();
      }

      match /proveedores/{proveedorId} {
        allow read: if estaLogueado();
        allow write: if puedeEditarCatalogo();
      }

      match /precios/{listaId} {
        allow read: if estaLogueado();
        allow write: if puedeEditarCatalogo();
      }
    }

    match /categorias/{id} {
      allow read: if estaLogueado();
      allow write: if puedeEditarCatalogo();
    }

    match /marcas/{id} {
      allow read: if estaLogueado();
      allow write: if puedeEditarCatalogo();
    }

    match /proveedores/{id} {
      allow read: if estaLogueado();
      allow write: if puedeEditarCatalogo();
    }

    match /clientes/{id} {
      allow read: if estaLogueado();
      allow write: if puedeVender(); // un vendedor tiene que poder cargar un cliente nuevo en el momento de la venta
    }

    match /sucursales/{id} {
      allow read: if estaLogueado();
      allow write: if esAdministrador();
    }

    match /depositos/{id} {
      allow read: if estaLogueado();
      allow write: if esAdministrador();
    }

    match /listasPrecios/{id} {
      allow read: if estaLogueado();
      allow write: if esAdministrador();
    }

    // Facturas de compra a proveedor: suman stock y actualizan costo de cada producto al crearse.
    // Inmutables una vez cargadas (igual que historialCostos/logAuditoria) para mantener la trazabilidad.
    match /compras/{id} {
      allow read: if estaLogueado();
      allow create: if puedeEditarCatalogo();
      allow update, delete: if false;
    }

    // Pagos a proveedor, atados a una factura de compra puntual. Inmutables una vez creados —
    // un pago cargado mal se corrige con un pago negativo o se deja una nota, nunca se edita/borra.
    match /pagosProveedores/{id} {
      allow read: if estaLogueado();
      allow create: if puedeEditarCatalogo();
      allow update, delete: if false;
    }

    // Órdenes de compra: pedidos/intenciones de compra que todavía no llegaron. A diferencia de
    // /compras, NO impactan stock ni costo — por eso sí se pueden editar (cambiar estado, etc.)
    // hasta que se reciban.
    match /ordenesCompra/{id} {
      allow read: if estaLogueado();
      allow create, update: if puedeEditarCatalogo();
      allow delete: if esAdministrador();
    }

    // Ventas: bajan stock y dejan una foto del costo de cada producto al momento de vender. Inmutables
    // una vez creadas, igual que /compras — una venta mal cargada se corrige con una nota, no se edita.
    match /ventas/{id} {
      allow read: if estaLogueado();
      allow create: if puedeVender();
      allow update, delete: if false;
    }

    // Cobros a cliente, atados a una venta puntual — contraparte de /pagosProveedores.
    match /cobros/{id} {
      allow read: if estaLogueado();
      allow create: if puedeVender();
      allow update, delete: if false;
    }

    // Correlativo interno del número de venta (contadores/ventas: { ultimo }).
    match /contadores/{id} {
      allow read: if estaLogueado();
      allow write: if puedeVender();
    }

    // Datos generales de la empresa (contacto, logo, datos fiscales) — configuracion/empresa.
    match /configuracion/{id} {
      allow read: if estaLogueado();
      allow write: if esAdministrador();
    }

    // Plan de cuentas contable: se siembra una vez y rara vez cambia — solo administrador lo toca.
    match /cuentasContables/{codigo} {
      allow read: if estaLogueado();
      allow write: if esAdministrador();
    }

    // Asientos contables: se generan solos desde ventas/compras/cobros/pagos, nunca a mano. Cualquiera
    // que pueda hacer esas operaciones (puedeVender() ya cubre los cuatro roles) puede generarlos.
    // Inmutables — un asiento mal generado se corrige con un asiento de ajuste, no editando el original.
    match /asientosContables/{id} {
      allow read: if estaLogueado();
      allow create: if puedeVender();
      allow update, delete: if false;
    }

    // Mercado Pago (entorno de pruebas): todo lo escribe el backend (Cloud Functions, con el Admin
    // SDK, que no pasa por estas reglas) — desde el cliente solo se puede leer, nunca escribir
    // directamente. Así el navegador no puede fabricar un "pago aprobado" ni tocar el log.
    match /pagosMercadoPago/{id} {
      allow read: if estaLogueado();
      allow write: if false;
    }

    match /devolucionesMercadoPago/{id} {
      allow read: if estaLogueado();
      allow write: if false;
    }

    match /logIntegracionMercadoPago/{id} {
      allow read: if estaLogueado();
      allow write: if false;
    }

    match /webhooksMercadoPagoProcesados/{id} {
      allow read: if false;
      allow write: if false;
    }
  }
}
