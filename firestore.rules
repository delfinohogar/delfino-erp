rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogueado() {
      return request.auth != null;
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function rol() {
      return perfil().rol;
    }

    function esAdministrador() {
      return estaLogueado() && rol() == 'administrador';
    }

    // Todo usuario logueado con perfil puede leer y escribir catálogo (productos, categorías, marcas, proveedores).
    // La escritura de campos sensibles (costos, overrides) queda para más adelante cuando haya permisos más finos por rol.
    function puedeEditarCatalogo() {
      return estaLogueado() && rol() in ['administrador', 'administrativo'];
    }

    // Todos los roles pueden vender (es el uso principal de un vendedor). Superset de puedeEditarCatalogo().
    function puedeVender() {
      return estaLogueado() && rol() in ['administrador', 'administrativo', 'vendedor'];
    }

    // Una venta descuenta stock de producto vía transacción — un vendedor necesita poder tocar ESE
    // campo puntual sin heredar permiso para editar costo/precio/etc. del catálogo. crearVenta()
    // (js/ventas.js) también pisa ultimoPrecioVenta/ultimaVentaEn en la misma transacción (referencia
    // de "última venta" para el buscador de Nueva Venta) — hasta ahora esos dos campos no estaban en
    // la lista y la regla rechazaba la transacción entera para cualquier usuario sin puedeEditarCatalogo()
    // (o sea, cualquier "vendedor" real), bloqueando toda venta hecha por ese rol.
    function soloActualizaStock() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockTotal', 'ultimoPrecioVenta', 'ultimaVentaEn', 'modificadoPor', 'modificadoEn']);
    }

    match /usuarios/{uid} {
      allow read: if estaLogueado();
      allow write: if esAdministrador();
      // Cada usuario puede guardar su propia personalización del Dashboard (qué tarjetas ve y en qué
      // orden) sin poder tocar su rol ni ningún otro campo del perfil.
      allow update: if estaLogueado() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dashboardCards']);

      // Auditoría de cambios de rol — mismo patrón que logAuditoria de productos (inmutable, solo
      // quien tiene permiso para escribir el usuario puede dejar la entrada).
      match /logAuditoria/{entryId} {
        allow read: if estaLogueado();
        allow create: if esAdministrador();
        allow update, delete: if false;
      }
    }

    // Necesaria además de la regla anidada de más abajo: las collection group queries (ej. "Movimientos",
    // que junta el log de auditoría de todos los productos) solo se autorizan con una regla en la raíz
    // que use el wildcard recursivo {path=**} — la regla anidada dentro de /productos/{id} alcanza para
    // leer/escribir el historial de un producto puntual, pero no para la query agrupada.
    match /{path=**}/logAuditoria/{entryId} {
      allow read: if estaLogueado();
    }

    match /productos/{productoId} {
      allow read: if estaLogueado();
      allow create, update: if puedeEditarCatalogo() || (puedeVender() && soloActualizaStock());
      allow delete: if esAdministrador();

      match /historialCostos/{entryId} {
        allow read: if estaLogueado();
        allow create: if puedeEditarCatalogo();
        allow update, delete: if false; // historial inmutable
      }

      match /logAuditoria/{entryId} {
        allow read: if estaLogueado();
        allow create: if puedeVender(); // ventas y compras/ajustes de catálogo dejan entrada acá
        allow update, delete: if false; // log inmutable
      }

      match /stockPorDeposito/{depositoId} {
        allow read: if estaLogueado();
        allow write: if puedeEditarCatalogo();
      }

      match /proveedores/{proveedorId} {
        allow read: if estaLogueado();
        allow write: if puedeEditarCatalogo();
      }

      match /precios/{listaId} {
        allow read: if estaLogueado();
        allow write: if puedeEditarCatalogo();
      }
    }

    match /categorias/{id} {
      allow read: if estaLogueado();
      allow write: if puedeEditarCatalogo();
    }

    match /marcas/{id} {
      allow read: if estaLogueado();
      allow write: if puedeEditarCatalogo();
    }

    match /proveedores/{id} {
      allow read: if estaLogueado();
      allow write: if puedeEditarCatalogo();
    }

    match /clientes/{id} {
      allow read: if estaLogueado();
      allow write: if puedeVender(); // un vendedor tiene que poder cargar un cliente nuevo en el momento de la venta
    }

    match /sucursales/{id} {
      allow read: if estaLogueado();
      allow write: if esAdministrador();
    }

    match /depositos/{id} {
      allow read: if estaLogueado();
      allow write: if esAdministrador();
    }

    match /listasPrecios/{id} {
      allow read: if estaLogueado();
      allow write: if esAdministrador();
    }

    // Facturas de compra a proveedor: suman stock y actualizan costo de cada producto al crearse.
    // Inmutables una vez cargadas (igual que historialCostos/logAuditoria) para mantener la trazabilidad.
    match /compras/{id} {
      allow read: if estaLogueado();
      allow create: if puedeEditarCatalogo();
      allow update, delete: if false;
    }

    // Pagos a proveedor, atados a una factura de compra puntual. Inmutables una vez creados —
    // un pago cargado mal se corrige con un pago negativo o se deja una nota, nunca se edita/borra.
    match /pagosProveedores/{id} {
      allow read: if estaLogueado();
      allow create: if puedeEditarCatalogo();
      allow update, delete: if false;
    }

    // Órdenes de compra: pedidos/intenciones de compra que todavía no llegaron. A diferencia de
    // /compras, NO impactan stock ni costo — por eso sí se pueden editar (cambiar estado, etc.)
    // hasta que se reciban.
    match /ordenesCompra/{id} {
      allow read: if estaLogueado();
      allow create, update: if puedeEditarCatalogo();
      allow delete: if esAdministrador();
    }

    // Ventas: bajan stock y dejan una foto del costo de cada producto al momento de vender. Inmutables
    // una vez creadas, igual que /compras — una venta mal cargada se corrige con una nota, no se edita.
    match /ventas/{id} {
      allow read: if estaLogueado();
      allow create: if puedeVender();
      allow update, delete: if false;
    }

    // Rastro de cada intento de crearVenta (js/ventas.js) — la venta en sí es inmutable y no alcanza
    // a registrar si un intento se cortó a mitad de camino (stock ya descontado pero la venta nunca
    // se llegó a crear). El documento lo crea y actualiza el mismo cliente que intenta la venta —
    // por eso update queda acotado a los campos de estado, nunca a los datos de origen (usuario,
    // creadoEn), para que no se pueda reescribir de qué venta se trataba.
    match /ventasIdempotencia/{id} {
      allow read: if estaLogueado();
      allow create: if puedeVender();
      allow update: if puedeVender() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'ventaId', 'resultado', 'error', 'actualizadoEn']);
      allow delete: if false;
    }

    // Cobros a cliente, atados a una venta puntual — contraparte de /pagosProveedores.
    match /cobros/{id} {
      allow read: if estaLogueado();
      allow create: if puedeVender();
      allow update, delete: if false;
    }

    // Deja constancia de que un pago que Tesorería no pudo ubicar solo (venta/cobro con
    // tieneSinUbicar) ya se resolvió a mano — la venta/cobro en sí no se toca (ver
    // js/resoluciones-pago-sin-ubicar.js). "Resolver de nuevo" simplemente pisa el doc, por eso
    // update también queda habilitado.
    match /resolucionesPagoSinUbicar/{id} {
      allow read: if estaLogueado();
      allow create, update: if puedeVender();
      allow delete: if false;
    }

    // Estado de entrega de una venta (id = ventaId) — vive acá y no en /ventas porque la venta es
    // inmutable. Se crea al vender (js/ventas.js crearVenta) y solo se puede tocar para marcarla
    // entregada.
    match /entregas/{id} {
      allow read: if estaLogueado();
      allow create: if puedeVender();
      allow update: if puedeVender() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'entregadoPor', 'entregadoPorNombre', 'entregadoEn']);
      allow delete: if false;
    }

    // Correlativo interno del número de venta y de comprobante (contadores/ventas,
    // contadores/comprobantes: { ultimo }).
    match /contadores/{id} {
      allow read: if estaLogueado();
      allow write: if puedeVender();
    }

    // Comprobantes internos de facturación (sin validez fiscal, sin ARCA todavía). No se borran
    // nunca — anular es un update de estado, no un delete. Una vez creado, un comprobante solo
    // puede tocar los campos de anulación, el flag de PDF generado y los campos fiscales (hoy sin
    // usar, preparados para cuando exista ARCA) — nunca los productos, el total ni el cliente.
    // numero/numeroCompleto quedan en null al crear un comprobante fiscal (arranca en
    // PROCESANDO_ARCA — el número lo asigna ARCA, no Delfino) y se completan recién acá, en el
    // mismo update donde llega el resultado de la autorización — ver crearComprobante en
    // js/facturacion.js.
    match /comprobantes/{id} {
      allow read: if estaLogueado();
      allow create: if puedeVender();
      allow update: if puedeVender() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado', 'motivoAnulacion', 'fechaAnulacion', 'anuladoPor', 'anuladoPorNombre',
          'pdfGenerado', 'actualizadoEn', 'numero', 'numeroCompleto',
          'arcaEstado', 'cae', 'caeVencimiento', 'qr', 'numeroFiscal', 'tipoComprobanteFiscal',
          'fechaAutorizacion', 'arcaErrorCodigo', 'arcaErrorDescripcion'
        ]);
      allow delete: if false;
    }

    // Datos generales de la empresa (contacto, logo, datos fiscales) — configuracion/empresa.
    match /configuracion/{id} {
      allow read: if estaLogueado();
      allow write: if esAdministrador();
    }

    // Plan de cuentas contable: se siembra una vez y rara vez cambia — solo administrador lo toca.
    match /cuentasContables/{codigo} {
      allow read: if estaLogueado();
      allow write: if esAdministrador();
    }

    // Asientos contables: se generan solos desde ventas/compras/cobros/pagos, nunca a mano. Cualquiera
    // que pueda hacer esas operaciones (puedeVender() ya cubre los cuatro roles) puede generarlos.
    // Inmutables — un asiento mal generado se corrige con un asiento de ajuste, no editando el original.
    match /asientosContables/{id} {
      allow read: if estaLogueado();
      allow create: if puedeVender();
      allow update, delete: if false;
    }

    // Mercado Pago (entorno de pruebas): todo lo escribe el backend (Cloud Functions, con el Admin
    // SDK, que no pasa por estas reglas) — desde el cliente solo se puede leer, nunca escribir
    // directamente. Así el navegador no puede fabricar un "pago aprobado" ni tocar el log.
    match /pagosMercadoPago/{id} {
      allow read: if estaLogueado();
      allow write: if false;
    }

    match /devolucionesMercadoPago/{id} {
      allow read: if estaLogueado();
      allow write: if false;
    }

    match /logIntegracionMercadoPago/{id} {
      allow read: if estaLogueado();
      allow write: if false;
    }

    match /webhooksMercadoPagoProcesados/{id} {
      allow read: if false;
      allow write: if false;
    }

    // Integración fiscal ARCA (WSFEv1) — igual criterio que los de Mercado Pago de arriba: la
    // Cloud Function usa Admin SDK (bypasea reglas), desde el cliente solo se puede leer el log
    // para diagnóstico, nunca escribir directamente ni ver el lock de numeración (no aporta nada
    // a la UI, es un detalle interno de concurrencia — ver arcaFacturacion.js).
    match /logIntegracionArca/{id} {
      allow read: if estaLogueado();
      allow write: if false;
    }

    match /arcaNumeracionLocks/{id} {
      allow read: if false;
      allow write: if false;
    }

    // --- Tienda Nube (preparado, sin conectar — ver docs/tiendanube-integracion.md) ----------------
    // La cola y las órdenes las escribe hoy el propio cliente (mismo rol que edita catálogo) porque
    // todavía no hay una Cloud Function que sincronice de verdad. El día que exista, esa función usa
    // el Admin SDK (bypasea reglas) y esto se puede endurecer a allow write: if false, igual que
    // pagosMercadoPago — no hace falta tocar el resto del modelo para ese cambio.
    match /colaSincronizacionTiendaNube/{id} {
      allow read: if estaLogueado();
      allow create, update: if puedeEditarCatalogo();
      allow delete: if false;
    }

    // El registro real ahora lo hace el webhook (functions/tiendanube.js, Admin SDK) — desde el
    // cliente ya no se puede fabricar una orden. "Procesar" una orden (crear la venta/factura) sí
    // sigue siendo una acción de un vendedor logueado, así que puede actualizar el puñado de campos
    // de resultado — nunca los datos de la orden en sí (items/cliente/total), que son los que llegó
    // Tiendanube y no tiene sentido que el cliente pueda reescribir.
    match /ordenesTiendaNube/{id} {
      allow read: if estaLogueado();
      allow create: if false;
      allow update: if puedeVender() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'ventaId', 'facturaId', 'procesadoEn', 'error']);
      allow delete: if false;
    }

    match /logIntegracionTiendaNube/{id} {
      allow read: if estaLogueado();
      allow write: if false;
    }

    // Historial de facturas importado desde GBP (solo lectura/consulta) — lo escribe únicamente
    // gbpSincronizarFacturas (Admin SDK), nunca la app.
    match /facturasGbp/{id} {
      allow read: if estaLogueado();
      allow write: if false;
    }

    // Fichas livianas de clientes de GBP que no son clientes reales de Delfino (no tienen cuenta
    // corriente ni aparecen en el buscador de Nueva Venta) — solo para mostrar nombres en reportes.
    // Las escribe únicamente gbpVincularClientes (Admin SDK).
    match /clientesGbp/{id} {
      allow read: if estaLogueado();
      allow write: if false;
    }

    // --- Tesorería -------------------------------------------------------------------------------
    // Mismo criterio que el resto del ERP: los movimientos financieros nunca se borran ni se editan
    // libremente — solo se pueden "anular" (allowlist de campos, gateado a administrador) o, en el
    // caso de movimientos bancarios, marcar como conciliados. El saldo de cada caja/cuenta se calcula
    // siempre a partir de estos movimientos (ver js/cajas.js, js/bancos.js) — nunca se guarda un saldo.

    // Catálogo de medios de pago (Efectivo, Mercado Pago...) — separado de las cuentas de Tesorería.
    // Lectura abierta porque el selector de pago de Nueva Venta lo necesita para cualquiera que venda.
    match /mediosPago/{id} {
      allow read: if estaLogueado();
      allow write: if esAdministrador();
    }

    match /cajas/{id} {
      allow read: if estaLogueado();
      allow write: if esAdministrador();
    }

    // Una sesión = un ciclo apertura → cierre de una caja puntual. Se crea al abrir (puedeVender,
    // cualquier cajero/vendedor puede abrir su caja) y solo se puede tocar de nuevo para cerrarla.
    match /sesionesCaja/{id} {
      allow read: if estaLogueado();
      allow create: if puedeVender();
      allow update: if puedeVender() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado', 'fechaCierre', 'cierrePor', 'cierrePorNombre',
          'saldoTeorico', 'dineroContado', 'diferencia', 'arqueo'
        ]);
      allow delete: if false;
    }

    match /movimientosCaja/{id} {
      allow read: if estaLogueado();
      allow create: if puedeVender();
      allow update: if esAdministrador() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'motivoAnulacion', 'anuladoPor', 'anuladoPorNombre', 'fechaAnulacion']);
      allow delete: if false;
    }

    match /bancos/{id} {
      allow read: if estaLogueado();
      allow write: if esAdministrador();
    }

    match /cuentasBancarias/{id} {
      allow read: if estaLogueado();
      allow write: if esAdministrador();
    }

    match /movimientosBancarios/{id} {
      allow read: if estaLogueado();
      allow create: if puedeVender();
      allow update: if
        (puedeVender() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'conciliadoPor', 'conciliadoPorNombre', 'fechaConciliacion', 'movimientoRelacionado'])) ||
        (esAdministrador() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'motivoAnulacion', 'anuladoPor', 'anuladoPorNombre', 'fechaAnulacion']));
      allow delete: if false;
    }

    // Chequeras: cargar una (rango de números que asignó el banco) es una acción de setup, como dar de
    // alta una cuenta bancaria — solo administrador. Consumir el próximo número al emitir un cheque
    // (proximoNumero) sí lo puede hacer cualquiera que pueda vender/operar Tesorería.
    match /chequeras/{id} {
      allow read: if estaLogueado();
      allow create: if esAdministrador();
      allow update: if
        (puedeVender() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proximoNumero'])) ||
        (esAdministrador() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activa']));
      allow delete: if false;
    }

    // Cheques emitidos: viven aparte de movimientosBancarios mientras están "pendiente" (cheque a
    // fecha futura, todavía no debitado de verdad) — recién al efectivizarse generan un movimiento
    // bancario real. Anular solo es posible pendiente, y solo administrador (mismo criterio que gastos).
    match /chequesEmitidos/{id} {
      allow read: if estaLogueado();
      allow create: if puedeVender();
      allow update: if
        (puedeVender() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'movimientoBancarioId', 'fechaEfectivizacion'])) ||
        (esAdministrador() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'motivoAnulacion', 'anuladoPor', 'anuladoPorNombre', 'fechaAnulacion']));
      allow delete: if false;
    }

    match /gastos/{id} {
      allow read: if estaLogueado();
      allow create: if puedeVender();
      allow update: if esAdministrador() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'motivoAnulacion', 'anuladoPor', 'anuladoPorNombre', 'fechaAnulacion']);
      allow delete: if false;
    }

    match /transferenciasInternas/{id} {
      allow read: if estaLogueado();
      allow create: if puedeVender();
      allow update, delete: if false;
    }

    // Mercado Pago / GoCuotas / Boston Cred / Tarjeta de crédito: la venta crea la cuenta por cobrar
    // (pendiente); registrar un cobro/acreditación solo puede tocar los campos de cobro, nunca el
    // origen (venta, cliente, importe bruto) que quedó fijado al crearse.
    match /cuentasPorCobrar/{id} {
      allow read: if estaLogueado();
      allow create: if puedeVender();
      allow update: if puedeVender() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'pagosRecibidos', 'totalCobrado', 'saldoPendiente', 'actualizadoEn', 'motivoAnulacion', 'anuladoPor']);
      allow delete: if false;
    }

    // Rastro de cada intento de revertirVentaPorNotaCredito (js/ventas.js) — misma razón que
    // ventasIdempotencia: la reversa toca stock + Tesorería + un asiento en varios pasos, y sin esto
    // un intento cortado a mitad de camino (ej. se devolvió el stock pero después falló el asiento)
    // no dejaría ningún rastro de que hay que revisarlo a mano.
    match /reversasVenta/{ventaId} {
      allow read: if estaLogueado();
      allow create: if puedeVender();
      allow update: if puedeVender() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'error', 'pendientesRevision', 'productosNoEncontrados', 'numeroVenta', 'actualizadoEn']);
      allow delete: if false;
    }
  }
}
